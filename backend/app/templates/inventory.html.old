{% extends "base.html" %}
{% block title %}InventoryTrack - Inventory{% endblock %}
{% block content %}
  <div class="page">
  <h2>Inventory</h2>

  <div class="tabs">
    <button id="tabNeedsSplit" type="button" class="tab">Needs Split</button>
    <button id="tabUnlisted" type="button" class="tab">Unlisted</button>
  </div>

  <div id="panelNeedsSplit">
    <table>
      <tbody id="needsSplitBody"></tbody>
    </table>
  </div>

  <div id="panelUnlisted" style="display:none;">
    <table>
      <tbody id="unlistedBody"></tbody>
    </table>
  </div>

  <div class="card">
    <div class="row">
      <div><b>Unconverted purchase lines:</b> <span id="unconverted">...</span></div>
      <div><b>Inventory items:</b> <span id="invcount">...</span></div>
      <div style="margin-left:auto"><button id="refreshBtn">Refresh</button></div>
    </div>

    <hr style="border:none;border-top:1px solid #eee;margin:16px 0;">

    <h2>Needs Split (Goodwill Lots)</h2>
    <p class="small">These are container lots (1 per Goodwill Item ID). Split them into sellable child items.</p>

    <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Container</th>
          <th>Goodwill</th>
          <th>Cost Total</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="needsSplitBody">
        <tr><td colspan="4">Loading...</td></tr>
      </tbody>
    </table>
    </div>

        <hr style="border:none;border-top:1px solid #eee;margin:18px 0;">

    <h2>Unlisted Items (Ready to SKU / Store / List)</h2>
    <table>
      <thead>
        <tr>
          <th>Item</th>
          <th>Cost</th>
          <th>SKU</th>
          <th>Location</th>
          <th>Save</th>
        </tr>
      </thead>
      <tbody id="unlistedBody">
        <tr><td colspan="5">Loading...</td></tr>
      </tbody>
    </table>

    <h3 style="margin-top:18px;">Result</h3>
    <div id="statusMsg" class="small" style="margin-top:10px;"></div>
    <pre id="result">{}</pre>
  </div>

<dialog id="splitDialog" style="border:none;border-radius:12px;max-width:900px;width:95%;">
  <div class="card" style="margin:0;">
    <div style="display:flex;gap:12px;align-items:flex-start;">
      <div style="flex:1;">
        <h2 style="margin-top:0;">Split lot</h2>
        <div class="small" id="splitMeta"></div>
      </div>
      <button id="splitCloseBtn" type="button">Close</button>
    </div>

    <hr>

    <div class="small">One item per line. Optional locked cost: Title | 12.34:</div>
    <textarea id="splitTitles" rows="10" style="width:100%;margin-top:8px;"
      placeholder="Example:
Mario Kart DS (loose)
Nintendo charger
Stylus
Case"></textarea>

    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:10px;">
      <span class="small">Helper:</span>
      <input id="splitCount" type="number" min="1" max="500" value="10" style="width:90px;">
      <button id="genLinesBtn" type="button">Generate placeholders</button>
      <span class="small">(then type over them)</span>
    </div>

    <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:14px;">
      <button id="splitSubmitBtn" type="button">Create Items</button>
    </div>

    <pre id="splitResult" style="margin-top:12px;">{}</pre>
  </div>
</dialog>

<script>
function setActiveTab(tab) {
  const needsBtn = document.getElementById("tabNeedsSplit");
  const unlistBtn = document.getElementById("tabUnlisted");

  const needsPanel = document.getElementById("panelNeedsSplit");
  const unlistPanel = document.getElementById("panelUnlisted");

  const isNeeds = tab === "needs_split";

  needsPanel.style.display = isNeeds ? "" : "none";
  unlistPanel.style.display = isNeeds ? "none" : "";

  needsBtn.classList.toggle("active", isNeeds);
  unlistBtn.classList.toggle("active", !isNeeds);

  if (isNeeds) loadNeedsSplit();
  else loadUnlisted();
}

document.getElementById("tabNeedsSplit").onclick = () => setActiveTab("needs_split");
document.getElementById("tabUnlisted").onclick = () => setActiveTab("unlisted");

// Load Needs Split first
setActiveTab("needs_split");
</script>


<script>
async function refreshCounts() {
  const res = await fetch("/inventory/status");
  const j = await res.json();
  document.getElementById("unconverted").textContent = j.unconverted_purchase_lines;
  document.getElementById("invcount").textContent = j.inventory_items;
}

function esc(s) {
  return (s ?? "").toString()
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;");
}

function openMiniWindow(url) {
  // Try for a small popup window. Browsers may clamp/ignore some features.
  const w = 980;
  const h = 780;

  const left = Math.max(0, Math.round((window.screen.width - w) / 2));
  const top  = Math.max(0, Math.round((window.screen.height - h) / 2));

  const features = [
    `width=${w}`,
    `height=${h}`,
    `left=${left}`,
    `top=${top}`,
    "resizable=yes",
    "scrollbars=yes",
    "toolbar=no",
    "menubar=no",
    "location=yes",   // leaving location on can help some sites
    "status=no"
  ].join(",");

  const win = window.open(url, "_blank", features);
  if (win) win.focus();
  return false; // so links don't also navigate current tab
}

let needsSplitById = {};

async function loadNeedsSplit() {
  const body = document.getElementById("needsSplitBody");
  body.innerHTML = `<tr><td colspan="4">Loading...</td></tr>`;

  const res = await fetch("/api/inventory/needs_split"); // must match your FastAPI route
  const data = await res.json();
  const rows = data.items || []; // <-- key fix

  needsSplitById = {};
  for (const r of rows) needsSplitById[r.id] = r;

  if (!rows.length) {
    body.innerHTML = `<tr><td colspan="4">No containers need split 🎉</td></tr>`;
    return;
  }

  body.innerHTML = rows.map(r => {
    const title = esc(r.title);
    const meta = `<div class="small">${esc(r.category || "")}<br>${esc(r.acquired_date || "")}</div>`;

    const itemId = esc(r.goodwill_item_id || "");
    const orderNum = esc(r.order_number || "");

    const itemUrl = itemId ? `https://shopgoodwill.com/item/${itemId}` : "";
    const orderUrl = orderNum ? `https://shopgoodwill.com/shopgoodwill/order/${orderNum}` : "";

    const goodwill = `
      <div>
        <div>
          <b>Item ID:</b>
          ${
            itemId
              ? `<a href="${itemUrl}" onclick="return openMiniWindow('${itemUrl}')" target="_blank" rel="noopener noreferrer">${itemId}</a>`
              : `<span class="small">—</span>`
          }
        </div>
        <div class="small" style="margin-top:6px;">
          <b>Order #:</b>
          ${
            orderNum
              ? `<a href="${orderUrl}" onclick="return openMiniWindow('${orderUrl}')" target="_blank" rel="noopener noreferrer">${orderNum}</a>`
              : `<span>—</span>`
          }
        </div>
      </div>
    `;

    const cost = (r.cost_total ?? 0).toFixed(2);

    return `
      <tr>
        <td><b>${title}</b>${meta}</td>
        <td>${goodwill}</td>
        <td>$${cost}</td>
        <td><button onclick="openSplitDialogById(${r.id})">Split (enter titles)</button></td>
      </tr>
    `;
  }).join("");
}


function openSplitDialogById(id) {
  const r = needsSplitById[id];
  if (!r) return;

  openSplitDialog(
    r.id,
    (r.title || "").toString(),
    (r.goodwill_item_id || "").toString(),
    (r.order_number || "").toString()
  );
}

async function refreshAll() {
  await refreshCounts();
  await loadNeedsSplit();
  await loadUnlisted();
}

document.getElementById("refreshBtn").addEventListener("click", refreshAll);

refreshAll();


async function loadUnlisted() {
  const body = document.getElementById("unlistedBody");
  body.innerHTML = `<tr><td colspan="5">Loading...</td></tr>`;

  const res = await fetch("/api/inventory/unlisted");
  const data = await res.json();
  const rows = data.items || [];   // <-- key fix

  if (!rows.length) {
    body.innerHTML = `<tr><td colspan="5">No unlisted items 🎉</td></tr>`;
    return;
  }

  body.innerHTML = rows.map(r => {
    const title = esc(r.title);
    const cost = (r.cost_total ?? 0).toFixed(2);
    return `
      <tr>
        <td><b>${title}</b><div class="small">${esc(r.acquired_date || "")}</div></td>
        <td>$${cost}</td>
        <td><input id="sku_${r.id}" value="${esc(r.sku || "")}" placeholder="SKU" style="width:140px;"></td>
        <td><input id="loc_${r.id}" value="${esc(r.location || "")}" placeholder="Bin/Shelf" style="width:140px;"></td>
        <td><button onclick="saveItem(${r.id})">Save</button></td>
      </tr>
    `;
  }).join("");
}


async function saveItem(id) {
  const sku = document.getElementById(`sku_${id}`).value || "";
  const location = document.getElementById(`loc_${id}`).value || "";
  const out = document.getElementById("result");
  out.textContent = "Saving...";
  const res = await fetch(`/inventory/update/${id}?sku=${encodeURIComponent(sku)}&location=${encodeURIComponent(location)}`, { method: "POST" });
  const txt = await res.text();
  try { out.textContent = JSON.stringify(JSON.parse(txt), null, 2); }
  catch { out.textContent = txt; }
}

let currentSplitId = null;

function goodwillItemUrl(itemId) {
  return itemId ? `https://shopgoodwill.com/item/${itemId}` : "";
}
function goodwillOrderUrl(orderNum) {
  return orderNum ? `https://shopgoodwill.com/shopgoodwill/order/${orderNum}` : "";
}

function openSplitDialog(containerId, containerTitle, goodwillItemId, orderNum) {
  currentSplitId = containerId;

  const itemUrl = goodwillItemUrl(goodwillItemId);
  const orderUrl = goodwillOrderUrl(orderNum);

  const metaLines = [];
  metaLines.push(`<b>Container:</b> ${containerTitle}`);
  if (goodwillItemId) metaLines.push(`<b>Item ID:</b> <a href="${itemUrl}" target="_blank" rel="noopener noreferrer">${goodwillItemId}</a>`);
  if (orderNum) metaLines.push(`<b>Order #:</b> <a href="${orderUrl}" target="_blank" rel="noopener noreferrer">${orderNum}</a>`);

  document.getElementById("splitMeta").innerHTML = metaLines.join("<br>");
  document.getElementById("splitTitles").value = "";
  document.getElementById("splitResult").textContent = "{}";

  document.getElementById("splitDialog").showModal();
  setTimeout(() => document.getElementById("splitTitles").focus(), 0);
}

document.getElementById("splitCloseBtn").addEventListener("click", () => {
  document.getElementById("splitDialog").close();
});

document.getElementById("genLinesBtn").addEventListener("click", () => {
  const n = parseInt(document.getElementById("splitCount").value || "1", 10);
  const lines = [];
  for (let i = 1; i <= Math.min(Math.max(n, 1), 500); i++) lines.push(`Item ${i}`);
  document.getElementById("splitTitles").value = lines.join("\n");
});

document.getElementById("splitSubmitBtn").addEventListener("click", async () => {
  const out = document.getElementById("splitResult");
  const titlesText = document.getElementById("splitTitles").value || "";

  out.textContent = "Working...";

  const res = await fetch(`/inventory/split-with-titles/${currentSplitId}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ titles_text: titlesText })
  });

  const txt = await res.text();
  let parsed = null;
  try { parsed = JSON.parse(txt); } catch {}

  out.textContent = parsed ? JSON.stringify(parsed, null, 2) : txt;

  if (parsed && parsed.ok) {
    setStatus(`✅ Split complete: created ${parsed.inserted_children} items ($${(parsed.allocated_each_cost_total ?? 0).toFixed(2)} each).`);
    await refreshCounts();
    await loadNeedsSplit();
    await loadUnlisted();
    document.getElementById("splitDialog").close();
  } else if (parsed && parsed.error) {
    setStatus(`⚠️ Split failed: ${parsed.error}`);
  }
});

function setStatus(msg) {
  const el = document.getElementById("statusMsg");
  if (!el) return;
  el.textContent = msg || "";
}

</script>
  </div>
{% endblock %}
